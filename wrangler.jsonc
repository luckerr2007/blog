{
	"name": "blog",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist"
	},
	// www 走 Cloudflare 优选 CNAME（DNS only），路由负责把 Host 交回 Worker。
	"routes": [
		{ "pattern": "www.taosu.dpdns.org/*", "zone_name": "taosu.dpdns.org" }
	],
	"previews": {}
}
