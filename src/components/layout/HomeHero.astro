---
// 首页顶部欢迎区
// 背景壁纸已关闭（backgroundWallpaper.mode = "none"），这里用一张卡片承担原先横幅的位置：
// 站点标题 + 打字机副标题 + 每日一言，保持首页有「首屏内容」而不是直接进入文章列表。
import HitokotoQuote from "@/components/common/HitokotoQuote.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper, siteConfig } from "@/config";
import { hitokotoConfig } from "@/config/hitokotoConfig";

const homeText = backgroundWallpaper.common?.homeText;
const subtitle = homeText?.subtitle;
const subtitleList = Array.isArray(subtitle)
	? subtitle.filter((item) => item.trim().length > 0)
	: subtitle
		? [subtitle]
		: [];
const showSubtitle = (homeText?.enable ?? true) && subtitleList.length > 0;
const typewriter = homeText?.typewriter;
---

<section
	class="home-hero card-base onload-animation relative overflow-hidden px-6 py-8 md:px-10 md:py-10 mb-4"
	aria-label="站点介绍"
>
	<div class="home-hero-glow" aria-hidden="true"></div>

	<div class="relative flex flex-col items-center gap-3 text-center">
		<p class="home-hero-eyebrow">Welcome</p>

		<div class="home-hero-title">
			{siteConfig.title}
		</div>

		{
			showSubtitle && (
				<div class="home-hero-subtitle">
					{typewriter?.enable !== false ? (
						<TypewriterText
							text={subtitleList}
							speed={typewriter?.speed ?? 120}
							deleteSpeed={typewriter?.deleteSpeed ?? 60}
							pauseTime={typewriter?.pauseTime ?? 3200}
						/>
					) : (
						subtitleList[0]
					)}
				</div>
			)
		}

		<div class="home-hero-divider" aria-hidden="true"></div>

		{hitokotoConfig.enable && hitokotoConfig.showOnHome && (
			<HitokotoQuote variant="hero" class="w-full" />
		)}
	</div>
</section>

<style>
	.home-hero {
		background-image: linear-gradient(
			135deg,
			color-mix(in oklab, var(--primary) 10%, transparent),
			transparent 55%
		);
	}

	.home-hero-glow {
		position: absolute;
		inset-inline: 0;
		top: -60%;
		height: 160%;
		background: radial-gradient(
			circle at 50% 0%,
			color-mix(in oklab, var(--primary) 22%, transparent),
			transparent 70%
		);
		pointer-events: none;
	}

	.home-hero-eyebrow {
		margin: 0;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--primary);
	}

	.home-hero-title {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-neutral-900, rgb(23 23 23));
	}

	:global(html.dark) .home-hero-title {
		color: rgb(245 245 245);
	}

	.home-hero-subtitle {
		min-height: 1.75rem;
		font-size: 0.95rem;
		color: var(--color-neutral-500, rgb(115 115 115));
	}

	:global(html.dark) .home-hero-subtitle {
		color: rgb(163 163 163);
	}

	.home-hero-divider {
		width: 3rem;
		height: 2px;
		border-radius: 9999px;
		background: color-mix(in oklab, var(--primary) 55%, transparent);
	}

	@media (min-width: 768px) {
		.home-hero-title {
			font-size: 2.1rem;
		}

		.home-hero-subtitle {
			font-size: 1.05rem;
		}
	}
</style>
