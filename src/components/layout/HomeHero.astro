---
// 首页顶部欢迎区（参考站 editorial hero 风格）
// 背景壁纸已关闭，这里用「通栏 + 下边框」的一屏文字承担首屏：
// 状态点 + mono 问候语 → 大字标题（字距收紧 + 高亮条）→ 打字机副标题 → 每日一言
import HitokotoQuote from "@/components/common/HitokotoQuote.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper, siteConfig } from "@/config";
import { hitokotoConfig } from "@/config/hitokotoConfig";

const homeText = backgroundWallpaper.common?.homeText;
const subtitle = homeText?.subtitle;
const subtitleList = Array.isArray(subtitle)
	? subtitle.filter((item) => item.trim().length > 0)
	: subtitle
		? [subtitle]
		: [];
const showSubtitle = (homeText?.enable ?? true) && subtitleList.length > 0;
const typewriter = homeText?.typewriter;
---

<section class="home-hero onload-animation" aria-label="站点介绍">
	<p class="home-hero-hello">欢迎来到我的小站</p>

	<h2 class="home-hero-title">
		{siteConfig.title}
	</h2>

	{
		showSubtitle && (
			<div class="home-hero-sub">
				{typewriter?.enable !== false ? (
					<TypewriterText
						text={subtitleList}
						speed={typewriter?.speed ?? 120}
						deleteSpeed={typewriter?.deleteSpeed ?? 60}
						pauseTime={typewriter?.pauseTime ?? 3200}
					/>
				) : (
					subtitleList[0]
				)}
			</div>
		)
	}

	{
		hitokotoConfig.enable && hitokotoConfig.showOnHome && (
			<div class="home-hero-quote">
				<HitokotoQuote variant="hero" />
			</div>
		)
	}
</section>

<style>
	.home-hero {
		padding: 0.5rem 1rem 2.5rem;
		margin-bottom: 0.5rem;
		border-bottom: 1px solid var(--c-border);
	}

	/* 状态点 + mono 问候语 */
	.home-hero-hello {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1.1rem;
		font-family: var(--mono-font);
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--c-fg-muted);
	}

	.home-hero-hello::before {
		content: "";
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: #34d399;
		box-shadow: 0 0 0 3px rgb(52 211 153 / 25%);
		animation: hero-pulse 2.4s var(--ref-ease) infinite;
	}

	/* 大字标题：字距收紧 + 底部高亮条 */
	.home-hero-title {
		position: relative;
		display: block;
		width: fit-content;
		margin: 0;
		/* Apple Large Title 比例：34–52px，字距随字号收紧 */
		font-size: clamp(2.125rem, 4.8vw + 0.9rem, 3.25rem);
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.022em;
		text-wrap: balance;
		color: var(--c-fg);
	}

	.home-hero-title::after {
		content: "";
		position: absolute;
		left: -0.08em;
		right: -0.08em;
		bottom: 0.02em;
		height: 0.3em;
		border-radius: 2px;
		background: color-mix(in oklab, var(--c-fg) 12%, transparent);
		z-index: -1;
	}

	.home-hero-sub {
		min-height: 1.7rem;
		margin-top: 1.1rem;
		max-width: 36rem;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--c-fg-muted);
	}

	.home-hero-quote {
		max-width: 40rem;
		margin-top: 1.5rem;
	}

	@media (min-width: 768px) {
		.home-hero {
			padding-bottom: 3rem;
		}

		.home-hero-sub {
			font-size: 1.125rem;
		}
	}

	@keyframes hero-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 3px rgb(52 211 153 / 25%);
		}
		50% {
			box-shadow: 0 0 0 7px rgb(52 211 153 / 0%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero-hello::before {
			animation: none;
		}
	}
</style>
