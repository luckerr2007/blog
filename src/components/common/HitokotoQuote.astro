---
// 每日一言展示组件（首页顶部 + 侧边栏共用）
// SSR 先渲染按日期轮换的本地句子，客户端再尝试用一言接口替换，失败则保持不变，
// 因此首屏不会空白，也不会因为接口挂掉而破版。
// 没有手动刷新按钮：每 1–6 小时随机换一句（间隔由 hitokotoConfig 指定）。
import { hitokotoConfig } from "@/config/hitokotoConfig";
import { getDailyFallback, getQuoteSourceLabel } from "@/utils/hitokoto-client";

interface Props {
	// hero：首页顶部，左对齐大字；widget：侧边栏，紧凑排版
	variant?: "hero" | "widget";
	// 是否显示出处
	showSource?: boolean;
	class?: string;
}

const { variant = "widget", showSource = true, class: className } = Astro.props;

const config = hitokotoConfig;
const initial = getDailyFallback(config);
const initialSource = initial ? getQuoteSourceLabel(initial) : "";
---

{config.enable && initial && (
	<div
		class:list={["hitokoto-quote", `hitokoto-quote-${variant}`, className]}
		data-hitokoto
		data-hitokoto-variant={variant}
		role="group"
		aria-label={config.title}
	>
		<div class="hitokoto-body">
			<p
				class="hitokoto-text text-neutral-700 dark:text-neutral-300"
				data-hitokoto-text
				aria-live="polite"
			>
				{initial.text}
			</p>
			{showSource && (
				<p class="hitokoto-source" data-hitokoto-source>
					{initialSource}
				</p>
			)}
		</div>
	</div>
)}

<style>
	.hitokoto-quote {
		display: flex;
		align-items: flex-start;
	}

	.hitokoto-body {
		flex: 1 1 auto;
		min-width: 0;
	}

	.hitokoto-text {
		margin: 0;
		text-wrap: pretty;
	}

	.hitokoto-text::before {
		content: "「";
	}

	.hitokoto-text::after {
		content: "」";
	}

	.hitokoto-source {
		margin: 0.35rem 0 0;
		opacity: 0.75;
	}

	.hitokoto-source:empty {
		display: none;
	}

	.hitokoto-text,
	.hitokoto-source {
		transition: opacity 0.25s ease;
	}

	.hitokoto-updated .hitokoto-text,
	.hitokoto-updated .hitokoto-source {
		animation: hitokoto-fade-in 0.45s ease both;
	}

	/* ── 首页 hero 变体 ───────────────────────────── */
	.hitokoto-quote-hero {
		max-width: 42rem;
		text-align: left;
	}

	.hitokoto-quote-hero .hitokoto-text {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--c-fg);
	}

	.hitokoto-quote-hero .hitokoto-source {
		margin-top: 0.5rem;
		font-family: var(--mono-font);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--c-fg-subtle);
	}

	/* ── 侧边栏变体 ───────────────────────────────── */
	.hitokoto-quote-widget .hitokoto-text {
		font-size: 0.9rem;
		line-height: 1.8;
	}

	.hitokoto-quote-widget .hitokoto-source {
		font-size: 0.75rem;
		text-align: right;
	}

	@keyframes hitokoto-fade-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hitokoto-updated .hitokoto-text,
		.hitokoto-updated .hitokoto-source {
			animation: none;
		}
	}
</style>

<script>
	import { hitokotoConfig } from "@/config/hitokotoConfig";
	import type { HitokotoQuote } from "@/types/hitokotoConfig";
	import {
		getCacheRemainingMs,
		getQuoteSourceLabel,
		loadQuote,
		randomRotateTtlMs,
		readCachedQuote,
	} from "@/utils/hitokoto-client";

	const selector = "[data-hitokoto]";
	// 首页顶部与侧边栏可能同时存在，共享同一个请求与同一个定时器
	let pending: Promise<HitokotoQuote | null> | null = null;
	let timer: number | undefined;

	const getRoots = (): HTMLElement[] =>
		Array.from(document.querySelectorAll<HTMLElement>(selector));

	const renderQuote = (root: HTMLElement, quote: HitokotoQuote): void => {
		const textElement = root.querySelector<HTMLElement>("[data-hitokoto-text]");
		const sourceElement =
			root.querySelector<HTMLElement>("[data-hitokoto-source]");
		if (textElement) textElement.textContent = quote.text;
		if (sourceElement) sourceElement.textContent = getQuoteSourceLabel(quote);
		root.classList.remove("hitokoto-updated");
		// 强制重排，保证每次自动轮换时淡入动画都会重放
		void root.offsetWidth;
		root.classList.add("hitokoto-updated");
	};

	const applyQuote = (quote: HitokotoQuote | null): void => {
		if (!quote) return;
		for (const root of getRoots()) renderQuote(root, quote);
	};

	const ensureQuote = async (force: boolean): Promise<void> => {
		if (!force && pending) {
			applyQuote(await pending);
			return;
		}
		pending = loadQuote(hitokotoConfig, { force });
		try {
			applyQuote(await pending);
		} finally {
			pending = null;
		}
	};

	// 按「本期句子的剩余有效期」安排下一次轮换；
	// 没有缓存（比如接口全挂、用的是兜底句子）时，退回到 1–6 小时的随机间隔重试
	const scheduleNext = (): void => {
		const remaining = getCacheRemainingMs();
		const delay = remaining > 0 ? remaining : randomRotateTtlMs(hitokotoConfig);
		for (const root of getRoots()) {
			root.dataset.hitokotoNext = String(Math.round(delay));
		}
		if (timer) clearTimeout(timer);
		timer = window.setTimeout(() => {
			void rotate();
		}, delay);
	};

	const rotate = async (): Promise<void> => {
		await ensureQuote(true);
		scheduleNext();
	};

	const init = (): void => {
		if (getRoots().length === 0) return;
		// Swup 换页后 DOM 换了新的，先用缓存里的同一句覆盖 SSR 兜底，再排下一次轮换
		applyQuote(readCachedQuote());
		void ensureQuote(false).then(scheduleNext);
	};

	init();

	// Swup 客户端换页不会重新执行模块脚本，需要在内容替换后补一次
	document.addEventListener("swup:contentReplaced", () => {
		init();
	});

	// 长时间开着的标签页切回前台时，如果这一句已经过期就立刻换
	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState !== "visible") return;
		if (getCacheRemainingMs() > 0) return;
		void rotate();
	});
</script>
