---
// 侧边栏「每日一言」小组件
import HitokotoQuote from "@/components/common/HitokotoQuote.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { hitokotoConfig } from "@/config/hitokotoConfig";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
---

{
	hitokotoConfig.enable && (
		<WidgetLayout
			id="hitokoto"
			name={hitokotoConfig.title}
			showTitle={showTitle}
			class={className}
			style={style}
		>
			<HitokotoQuote variant="widget" />
		</WidgetLayout>
	)
}
